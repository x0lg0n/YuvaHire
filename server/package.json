{
  "name": "yuvahire-backend",
  "version": "1.0.0",
  "description": "Industry-grade backend API for YuvaHire college job portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=controllers|models|middlewares",
    "test:integration": "jest --testPathPattern=api.test.js",
    "test:performance": "node tests/performance/load-test.js",
    "test:performance:memory": "node tests/performance/load-test.js --memory",
    "test:e2e": "jest --config jest.e2e.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "security-audit": "npm audit --audit-level moderate",
    "prepare": "husky install",
    "docker:build": "docker build -t yuvahire-backend .",
    "docker:run": "docker run -p 5000:5000 yuvahire-backend",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "health:check": "node scripts/health-check.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:performance"
  },
  "keywords": [
    "job-portal",
    "college",
    "students",
    "api",
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "industry-grade"
  ],
  "author": "YuvaHire Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@sentry/node": "^7.88.0",
    "@types/jest": "^29.5.8",
    "artillery": "^2.0.0-27",
    "autocannon": "^7.15.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "faker": "^6.6.6",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prom-client": "^15.0.0",
    "supertest": "^6.3.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuvahire/backend.git"
  },
  "bugs": {
    "url": "https://github.com/yuvahire/backend/issues"
  },
  "homepage": "https://github.com/yuvahire/backend#readme"
}
